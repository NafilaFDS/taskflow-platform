# Copy to .env (git-ignored) and set real values before `docker compose up`.
# Credentials are supplied at runtime only - never baked into the image.

# MongoDB root user. The password is embedded in MONGODB_URI, so use
# URL-safe characters only (letters, digits, - _ .).
MONGO_ROOT_USERNAME=taskflow_admin
MONGO_ROOT_PASSWORD=

# Grafana login is admin / this password.
GRAFANA_ADMIN_PASSWORD=

# Host port for the app (container port is 3000). 3000 on the host is in use.
APP_PORT=3100
