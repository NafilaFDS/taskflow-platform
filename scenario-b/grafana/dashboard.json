        }
      ],
      "title": "E · N+1 detector: DB queries per request by route (median, selected time range)",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Executions per second above the 16 ms bucket boundary: total count minus the le=\"0.016\" bucket. Threshold justified in ANSWERS.md.",
      "fieldConfig": {
