          "refId": "A"
        }
      ],
      "title": "G · Rows returned per notes_list query (GET /api/notes): query count by result size",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "p95 request latency and share of requests answered with 5xx, per tenant, 1m rate window.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
